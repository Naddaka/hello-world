# Copy to .env and fill in. Never commit .env.

# Password for the single user (required).
APP_PASSWORD=change-me

# Optional: key for signing the session cookie. If empty, derived from APP_PASSWORD
# (so changing the password logs out all sessions).
SESSION_SECRET=

# Where the SQLite DB and generated files live.
DATA_DIR=./data

# mock = no network calls, test results; real = call provider APIs.
PROVIDER_MODE=mock

# Provider keys (only needed with PROVIDER_MODE=real).
FAL_KEY=
BYTEPLUS_API_KEY=        # ModelArk console, region ap-southeast-1

# Time zone for month boundaries in spend reports.
APP_TIMEZONE=Europe/Kyiv

# Monthly spend limit, USD. Empty = no limit.
MONTHLY_BUDGET_USD=

# Background job loop.
MAX_CONCURRENT_JOBS=5
WORKER_INTERVAL_MS=2000

# Mock provider: fake generation time range, ms.
MOCK_MIN_MS=5000
MOCK_MAX_MS=15000
