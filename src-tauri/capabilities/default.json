{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "sql:default",
    "sql:allow-execute",
    "opener:allow-open-url",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$APPDATA/media/**"
        }
      ]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [
        {
          "path": "$APPDATA/media/**"
        }
      ]
    },
    "dialog:allow-open",
    "dialog:allow-save",
    "core:window:allow-set-fullscreen",
    "core:window:allow-destroy",
    "allow-media-location",
    "allow-import-media-file",
    "allow-save-media-bytes",
    "allow-import-media-url",
    "allow-download-media",
    "allow-read-text-file",
    "allow-delete-media",
    "allow-prune-media",
    "allow-media-frame-rate",
    "allow-write-file",
    "allow-print-window",
    "allow-link-preview",
    "allow-milanote-open",
    "allow-milanote-run",
    "allow-milanote-close",
    "allow-milanote-read-export"
  ]
}
